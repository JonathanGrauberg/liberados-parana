# Copiar como .env.local y completar. En Vercel: Settings › Environment Variables.
# NUNCA poner valores reales en este archivo (se sube a GitHub).

# Contraseña del panel /admin-lp
ADMIN_PASSWORD=cambiar-esta-contraseña
# Texto largo y aleatorio que firma las sesiones (ej.: openssl rand -base64 32)
SESSION_SECRET=cambiar-por-un-texto-largo-aleatorio
# Base de datos Postgres (Neon): cadena de conexión
DATABASE_URL="postgresql://usuario:contraseña@host/basededatos?sslmode=require"
